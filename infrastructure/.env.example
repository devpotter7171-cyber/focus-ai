# ================================================
# Focus-AI Environment Variables
# ================================================
# Copy this file to .env and fill in your values
# ================================================

# ----------------
# FRONTEND (Next.js)
# ----------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: Supabase (if using instead of/alongside Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# API URL (for frontend to call backend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ----------------
# BACKEND (FastAPI)
# ----------------
# Firebase Admin SDK credentials
# Can be a file path or the JSON content as a string
FIREBASE_ADMIN_CREDENTIALS_JSON=./firebase-admin-key.json

# Database connection string
DATABASE_URL=postgresql://focusai:focusai@localhost:5432/focusai

# For SQLite during development (simpler setup)
# DATABASE_URL=sqlite+aiosqlite:///./focus_ai.db

# Secret key for JWT token signing (generate a strong random string)
SECRET_KEY=your_super_secret_key_change_in_production

# Frontend URL for CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:3000

# Supabase (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key

# ----------------
# ML SERVICE
# ----------------
# Path where trained models are stored
ML_STORAGE_PATH=./ml/models

# Enable/disable sensitive logging
ENABLE_SENSITIVE_LOGGING=false

# ----------------
# DOCKER / INFRASTRUCTURE
# ----------------
# PostgreSQL settings for Docker Compose
POSTGRES_USER=focusai
POSTGRES_PASSWORD=focusai
POSTGRES_DB=focusai

# Redis (optional, for bandit state caching)
REDIS_URL=redis://localhost:6379

# ----------------
# EXPERIMENT SETTINGS
# ----------------
# Enable experiment mode (control/adaptive assignment)
EXPERIMENT_MODE=false

# Experiment ID for logging
EXPERIMENT_ID=pilot_001
