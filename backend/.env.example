# Backend Environment Variables
# Copy this file to .env and fill in your values

# Firebase Admin SDK - Path to your service account JSON file
FIREBASE_ADMIN_CREDENTIALS=/path/to/your/firebase-adminsdk.json

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini (required for tutor, hint, mistake-analysis, course gen)
GEMINI_API_KEY=
# Optional: override the default model. Defaults to gemini-2.5-flash-lite.
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenRouter (free models fallback chain — recommended for token savings)
# Get your key at https://openrouter.ai/keys (free tier available)
OPENROUTER_API_KEY=
# Optional: your site URL and app name for OpenRouter analytics
OPENROUTER_SITE_URL=https://focus-ai.demo
OPENROUTER_APP_NAME=Focus-AI
